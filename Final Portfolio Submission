                font-size: 38px;
            }

            .hero h3 {
                font-size: 21px;
            }

            .hero p {
                font-size: 16px;
            }

            section {
                padding: 60px 0;
            }

            .section-title {
                font-size: 30px;
            }

            .container {
                width: 92%;
            }
        }

    </style>
</head>


