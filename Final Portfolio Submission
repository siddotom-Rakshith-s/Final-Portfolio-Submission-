        .contact-card {
            background: white;

            padding: 25px;

            border-radius: 12px;

            box-shadow:
                0 5px 18px rgba(0,0,0,0.08);

            transition: 0.3s;
        }

        .contact-card:hover {
            transform: translateY(-5px);
        }

        .contact-card .icon {
            font-size: 35px;
            margin-bottom: 10px;
        }

        .contact-card h3 {
            color: #2563eb;
            margin-bottom: 8px;
        }

        .contact-card a {
            color: #475569;
            word-break: break-word;
