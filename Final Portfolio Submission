        .resume p {
            color: #64748b;
            margin-bottom: 15px;
        }



        .contact {
            text-align: center;
        }

        .contact-info {
            display: grid;

            grid-template-columns:
                repeat(
                    auto-fit,
                    minmax(220px, 1fr)
