        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: Arial, sans-serif;
            background: #f8fafc;
            color: #172033;
            line-height: 1.6;
        }

        a {
            text-decoration: none;
        }

        .container {
            width: 90%;
            max-width: 1100px;
            margin: auto;
        }


        nav {
            position: sticky;
            top: 0;
            z-index: 1000;

            background: #111827;

            padding: 18px 5%;

            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        nav h2 {
            color: white;
        }

        nav ul {
            display: flex;
            list-style: none;
            gap: 25px;
        }

        nav ul a {
            color: white;
            font-weight: bold;
            transition: 0.3s;
        }

        nav ul a:hover {
            color: #60a5fa;
        }



        .hero {
            min-height: 90vh;

            display: flex;
            justify-content: center;
            align-items: center;

            text-align: center;

            padding: 50px 20px;

            background:
                linear-gradient(
                    135deg,
                    #dbeafe,
                    #f8fafc
                );
        }

        .hero h1 {
            font-size: 55px;
            margin-bottom: 15px;
        }

        .hero h1 span {
            color: #2563eb;
        }

        .hero h3 {
            font-size: 25px;
            margin-bottom: 15px;
            color: #334155;
        }

        .hero p {
            color: #64748b;
            font-size: 18px;
            max-width: 650px;
            margin: auto;
        }

        .buttons {
            margin-top: 25px;
        }

        .btn {
            display: inline-block;

            padding: 12px 25px;
            margin: 5px;

            border-radius: 8px;

            background: #2563eb;
            color: white;

            font-weight: bold;

            transition: 0.3s;
        }

        .btn:hover {
            background: #1d4ed8;
            transform: translateY(-3px);
        }

        .btn-outline {
            background: transparent;
            color: #2563eb;
            border: 2px solid #2563eb;
        }

        .btn-outline:hover {
            background: #2563eb;
            color: white;
        }



        section {
            padding: 80px 0;
        }

        .section-title {
            text-align: center;
            font-size: 35px;
            margin-bottom: 45px;
        }



        .about {
            max-width: 850px;
            margin: auto;
            text-align: center;
        }

        .about p {
            font-size: 18px;
            color: #64748b;
        }



        .skills {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;

            gap: 15px;

            margin-top: 30px;
        }

        .skill {
            background: white;

            padding: 12px 22px;

            border-radius: 25px;

            box-shadow:
                0 4px 15px rgba(0,0,0,0.08);

            font-weight: bold;
        }


        .projects {
            display: grid;

            grid-template-columns:
                repeat(
                    auto-fit,
                    minmax(280px, 1fr)
                );

            gap: 25px;
        }

        .project-card {
            background: white;

            padding: 30px;

            border-radius: 15px;

            box-shadow:
                0 5px 20px rgba(0,0,0,0.08);

            transition: 0.3s;
        }

        .project-card:hover {
            transform: translateY(-8px);

            box-shadow:
                0 12px 30px rgba(0,0,0,0.12);
        }

        .project-card h3 {
            color: #2563eb;
            margin-bottom: 12px;
        }

        .project-card p {
            color: #64748b;
            margin-bottom: 20px;
        }

        .project-links a {
            color: #2563eb;
            font-weight: bold;
            margin-right: 15px;
        }



        .education {
            max-width: 800px;
            margin: auto;
        }

        .education-card {
            background: white;

            padding: 25px;

            margin-bottom: 20px;

            border-left:
                5px solid #2563eb;

            border-radius: 8px;

            box-shadow:
                0 5px 15px rgba(0,0,0,0.07);
